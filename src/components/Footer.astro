---
import Band from './Band.astro';
import Icon from './Icon.astro';
import Search from './Search.astro';
import { CV_PDF, CV_URL, FOOTER_CREDIT, SOCIAL_LINKS } from '../consts';
import { url } from '../utils/paths';

const year = new Date().getFullYear();
---

<Band class="site-footer" nodes="t" seed={91}>
	<div class="noise"></div>
	<div class="footer-grid">
		<div class="footer-col footer-about">
			<h3>Jitendra Verma &copy; <span data-year>{year}</span></h3>
			<hr />
			<p>Software developer building mobile and web apps with Flutter, Swift, and modern web tech.</p>
			<p><a href={FOOTER_CREDIT.sourceUrl} target="_blank" rel="noopener noreferrer">Source on GitHub</a></p>
			<p>Website design inspired by <a href="https://zed.dev" target="_blank" rel="noopener noreferrer">zed.dev</a></p>
		</div>
		<div class="footer-col">
			<h3>Site</h3>
			<ul>
				<li><a href={url('/projects')}>Projects</a></li>
				<li><a href={url('/blog')}>Blog</a></li>
				<li><a href={url(CV_URL)} data-resume-pdf={url(CV_PDF)}>Resume</a></li>
			</ul>
		</div>
		<div class="footer-col">
			<h3>Writing</h3>
			<ul>
				<li><a href={url('/archive')}>Archive</a></li>
				<li><a href={url('/tags')}>Tags</a></li>
				<li><a href={url('/rss.xml')}>RSS</a></li>
			</ul>
		</div>
		<div class="footer-col">
			<h3>Connect</h3>
			<ul>
				{SOCIAL_LINKS.map((link) => {
					const mail = link.href.startsWith('mailto:');
					return (
						<li>
							<a href={link.href} target={mail ? undefined : '_blank'} rel={mail ? undefined : 'noopener noreferrer'}>
								{link.label}{!mail && <span class="ext">&#8599;</span>}
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</div>
	<div class="engrave" aria-hidden="true">
		<div class="engrave-art">
			<svg viewBox="0 0 1026 190" fill="none">
				<text x="513" y="147" text-anchor="middle">@jitendravjh</text>
			</svg>
		</div>
	</div>
</Band>

<Search />

<dialog id="author-modal" class="author-modal" aria-labelledby="modal-name">
	<button class="icon-btn close" type="button" data-close aria-label="Close"><Icon name="close" /></button>
	<div class="who">
		<img id="modal-avatar" src="" alt="" />
		<div>
			<h3 id="modal-name"></h3>
			<span class="label" id="modal-title"></span>
		</div>
	</div>
	<p id="modal-bio"></p>
	<div class="socials" id="modal-socials"></div>
</dialog>

<template id="modal-icons">
	<a data-kind="website" class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Website"><Icon name="globe" /></a>
	<a data-kind="github" class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a>
	<a data-kind="linkedin" class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
	<a data-kind="google_scholar" class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar"><Icon name="doc" /></a>
	<a data-kind="email" class="icon-btn" aria-label="Email"><Icon name="mail" /></a>
</template>

<script>
	// the year is baked in at build time and the site only rebuilds on push, so fix it up on load
	for (const el of document.querySelectorAll('[data-year]')) {
		el.textContent = String(new Date().getFullYear());
	}

	type Member = {
		name: string;
		title?: string;
		role?: string;
		bio?: string;
		avatar?: string;
		[key: string]: string | undefined;
	};

	const modal = document.getElementById('author-modal') as HTMLDialogElement | null;
	const icons = document.getElementById('modal-icons') as HTMLTemplateElement | null;

	const initials = (name: string) => {
		const parts = name.split(/\s+/).map((p) => p.replace(/[^A-Za-z]/g, '')).filter(Boolean);
		if (!parts.length) return 'NA';
		if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
		return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
	};

	const fallback = (name: string) => {
		const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><rect width="200" height="200" fill="#1348dc"/><text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" font-family="Georgia, serif" font-size="80" fill="#fff">${initials(name)}</text></svg>`;
		return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`;
	};

	const open = (member: Member) => {
		if (!modal || !icons) return;
		const avatar = modal.querySelector<HTMLImageElement>('#modal-avatar')!;
		avatar.onerror = () => {
			avatar.onerror = null;
			avatar.src = fallback(member.name);
		};
		avatar.src = member.avatar || fallback(member.name);
		modal.querySelector('#modal-name')!.textContent = member.name;
		modal.querySelector('#modal-title')!.textContent = [member.title, member.role].filter(Boolean).join(' · ');
		modal.querySelector('#modal-bio')!.textContent = member.bio || '';

		const socials = modal.querySelector('#modal-socials')!;
		socials.textContent = '';
		for (const a of icons.content.querySelectorAll<HTMLAnchorElement>('a')) {
			const value = member[a.dataset.kind!];
			if (!value) continue;
			const link = a.cloneNode(true) as HTMLAnchorElement;
			link.href = a.dataset.kind === 'email' ? `mailto:${value}` : value;
			socials.append(link);
		}
		modal.showModal();
	};

	for (const el of document.querySelectorAll<HTMLElement>('.author-modal-trigger')) {
		el.addEventListener('click', (e) => {
			e.preventDefault();
			const raw = el.dataset.member;
			if (raw) open(JSON.parse(raw) as Member);
		});
	}

	modal?.querySelector('[data-close]')?.addEventListener('click', () => modal.close());
	modal?.addEventListener('click', (e) => {
		const box = modal.getBoundingClientRect();
		const outside = e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
		if (outside) modal.close();
	});
</script>
