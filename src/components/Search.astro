---
import '@pagefind/default-ui/css/ui.css';
import Icon from './Icon.astro';

interface Props {
	id: string;
	placeholder?: string;
}

const { id, placeholder = 'Search' } = Astro.props;
---

<div class="nav-search" data-search-root>
	<label class="nav-search-field" for={`${id}-input`}>
		<Icon name="search" />
		<input
			id={`${id}-input`}
			class="nav-search-input"
			type="search"
			autocomplete="off"
			placeholder={placeholder}
			data-search-stub
		/>
	</label>
	<div class="nav-search-mount" id={id} hidden></div>
</div>

<script>
	// Pagefind ships its own input, so the stub above is what shows until someone
	// reaches for it. Loading the bundle on first focus keeps it off every page load.
	for (const root of document.querySelectorAll<HTMLElement>('[data-search-root]')) {
		const stub = root.querySelector<HTMLInputElement>('[data-search-stub]');
		const mount = root.querySelector<HTMLElement>('.nav-search-mount');
		if (!stub || !mount) continue;

		let started = false;
		const start = () => {
			if (started) return;
			started = true;
			if (import.meta.env.DEV) {
				mount.hidden = false;
				mount.innerHTML = '<p class="search-dev">Search needs a production build.</p>';
				return;
			}
			import('@pagefind/default-ui').then(({ PagefindUI }) => {
				new PagefindUI({
					baseUrl: import.meta.env.BASE_URL,
					bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
					element: mount,
					showImages: false,
					showSubResults: true,
				});
				mount.hidden = false;
				root.querySelector<HTMLElement>('.nav-search-field')?.setAttribute('hidden', '');
				const real = mount.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
				if (!real) return;
				real.placeholder = stub.placeholder;
				if (stub.value) {
					real.value = stub.value;
					real.dispatchEvent(new Event('input', { bubbles: true }));
				}
				real.focus();
			});
		};

		stub.addEventListener('focus', start);
		stub.addEventListener('input', start);

		root.addEventListener('keydown', (e) => {
			if ((e as KeyboardEvent).key !== 'Escape') return;
			const input = root.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
			if (input?.value) {
				input.value = '';
				input.dispatchEvent(new Event('input', { bubbles: true }));
			}
			input?.blur();
		});
	}
</script>
