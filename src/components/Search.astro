---
import Icon from './Icon.astro';

interface Props {
	id: string;
	placeholder?: string;
}

const { id, placeholder = 'Search' } = Astro.props;
---

<div class="nav-search" data-search-root>
	<label class="nav-search-field" for={`${id}-input`}>
		<Icon name="search" />
		<input
			id={`${id}-input`}
			class="nav-search-input"
			type="search"
			autocomplete="off"
			spellcheck="false"
			placeholder={placeholder}
			aria-label="Search"
		/>
	</label>
	<div class="nav-search-results" hidden></div>
</div>

<script>
	const base = import.meta.env.BASE_URL.replace(/\/$/, '');

	type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta?: { title?: string } }> };
	type Pagefind = {
		options: (o: Record<string, unknown>) => Promise<void>;
		debouncedSearch: (q: string) => Promise<{ results: PagefindResult[] } | null>;
	};

	// The bundler rewrites a plain dynamic import and cannot resolve this one at
	// build time, so it leaves its preload placeholder behind. Going through
	// Function keeps the import out of its reach.
	const importModule = new Function('u', 'return import(u)') as (u: string) => Promise<Pagefind>;

	let pagefind: Promise<Pagefind> | null = null;
	// one index for the page, whichever field asks for it first
	const load = () =>
		(pagefind ??= importModule(`${base}/pagefind/pagefind.js`).then(async (mod) => {
			await mod.options({ baseUrl: base || '/' });
			return mod;
		}));

	for (const root of document.querySelectorAll<HTMLElement>('[data-search-root]')) {
		const input = root.querySelector<HTMLInputElement>('.nav-search-input');
		const panel = root.querySelector<HTMLElement>('.nav-search-results');
		if (!input || !panel) continue;

		const collapse = () => {
			root.removeAttribute('data-open');
			panel.hidden = true;
			panel.replaceChildren();
			input.value = '';
		};

		const note = (text: string) => {
			panel.replaceChildren();
			const p = document.createElement('p');
			p.className = 'nav-search-empty';
			p.textContent = text;
			panel.append(p);
			panel.hidden = false;
		};

		const render = (rows: { url: string; title: string; excerpt: string }[]) => {
			panel.replaceChildren();
			if (!rows.length) note('Nothing found.');
			for (const row of rows) {
				const a = document.createElement('a');
				a.href = row.url;
				const title = document.createElement('span');
				title.className = 'r-title';
				title.textContent = row.title;
				const excerpt = document.createElement('span');
				excerpt.className = 'r-excerpt';
				excerpt.innerHTML = row.excerpt;
				a.append(title, excerpt);
				panel.append(a);
			}
			panel.hidden = false;
		};

		input.addEventListener('focus', () => root.setAttribute('data-open', ''));

		input.addEventListener('input', async () => {
			const q = input.value.trim();
			if (!q) {
				panel.hidden = true;
				panel.replaceChildren();
				return;
			}
			let api: Pagefind;
			try {
				api = await load();
			} catch {
				// the index only exists in a built site
				note('Search needs a production build.');
				return;
			}
			const search = await api.debouncedSearch(q);
			// a newer keystroke superseded this one
			if (search === null || input.value.trim() !== q) return;
			const rows = await Promise.all(search.results.slice(0, 6).map((r) => r.data()));
			render(rows.map((d) => ({ url: d.url, title: d.meta?.title ?? d.url, excerpt: d.excerpt })));
		});

		root.addEventListener('keydown', (e) => {
			if ((e as KeyboardEvent).key === 'Escape') {
				collapse();
				input.blur();
			}
		});

		document.addEventListener('click', (e) => {
			if (root.contains(e.target as Node)) return;
			if (input.value.trim()) return;
			collapse();
		});

		root.addEventListener('focusout', () => {
			requestAnimationFrame(() => {
				if (root.contains(document.activeElement)) return;
				if (input.value.trim()) return;
				collapse();
			});
		});
	}
</script>
