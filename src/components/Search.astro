---
import '@pagefind/default-ui/css/ui.css';
---

<div id="search-overlay" class="search-overlay" hidden>
	<div class="search-backdrop" data-search-close></div>
	<div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
		<div class="search-panel-header">
			<span class="label">Search</span>
			<button class="search-close" type="button" data-search-close aria-label="Close search"><kbd>Esc</kbd></button>
		</div>
		<div class="search-panel-content">
			{
				import.meta.env.DEV ? (
					<p class="search-dev">Search only works in a production build. Run a build and preview it to try it out.</p>
				) : (
					<div id="pagefind__search" />
				)
			}
		</div>
	</div>
</div>

<script>
	const overlay = document.getElementById('search-overlay');

	const focusInput = () => overlay?.querySelector<HTMLElement>('.pagefind-ui__search-input')?.focus();

	const openSearch = () => {
		if (!overlay) return;
		overlay.hidden = false;
		document.body.style.overflow = 'hidden';
		const box = document.getElementById('pagefind__search');
		if (box && !box.children.length && !import.meta.env.DEV) {
			import('@pagefind/default-ui').then(({ PagefindUI }) => {
				new PagefindUI({
					baseUrl: import.meta.env.BASE_URL,
					bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
					element: '#pagefind__search',
					showImages: false,
					showSubResults: true,
				});
				focusInput();
			});
		} else {
			requestAnimationFrame(focusInput);
		}
	};

	const closeSearch = () => {
		if (!overlay) return;
		overlay.hidden = true;
		document.body.style.overflow = '';
	};

	document.addEventListener('open-search', openSearch);
	for (const el of document.querySelectorAll('[data-search-close]')) el.addEventListener('click', closeSearch);

	window.addEventListener('keydown', (e) => {
		if (!overlay) return;
		if (e.key === 'Escape' && !overlay.hidden) {
			e.preventDefault();
			closeSearch();
		}
		if (e.key === '/' && overlay.hidden) {
			const typing = (e.target as HTMLElement | null)?.closest?.('input, textarea, select, [contenteditable]');
			if (!typing) {
				e.preventDefault();
				openSearch();
			}
		}
	});
</script>
