---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
import { url } from '../utils/paths';

interface Props {
	title: string;
	description: string;
	image?: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Paths that actually have a generated OG PNG (mirrors src/pages/[...route].png.ts).
// Anything else falls back to /og.png so og:image never 404s.
const blogIds = (await getCollection('blog')).map((post) => post.id);
const ogPaths = new Set<string>([
	'projects',
	'blog',
	...blogIds.map((id) => `blog/${id}`),
	...projectsData.map((project) => `projects/${project.id}`),
]);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
let currentPath = Astro.url.pathname;
if (currentPath.startsWith(basePath)) {
	currentPath = currentPath.substring(basePath.length);
}
currentPath = currentPath.replace(/^\/|\/$/g, '');

// the site opens in light mode, so shared links get the light cut of the card
const defaultImg = currentPath !== '' && ogPaths.has(currentPath) ? `/${currentPath}-light.png` : '/og-light.png';

const { title, description, image = defaultImg } = Astro.props;

const resolveImage = (img: string) => {
	if (img.startsWith('http')) return img;
	const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
	if (img.startsWith(base)) return img;
	return `${base}${img.replace(/^\//, '')}`;
};

const imageUrl = typeof image === 'string'
	? new URL(resolveImage(image), Astro.url)
	: new URL(image.src, Astro.url);
---

<meta charset="utf-8" />
<script is:inline data-cfasync="false">
	(() => {
		let saved = null;
		try {
			saved = localStorage.getItem('theme');
		} catch {}
		// the visitor's own choice wins, everyone else starts in light whatever the device prefers
		const theme = saved === 'dark' ? 'dark' : 'light';
		document.documentElement.dataset.theme = theme;
		document.addEventListener('DOMContentLoaded', () => {
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#121316' : '#f5f4f3');
		});
	})();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="google-site-verification" content="UTlYvpET8RMryubJxU2s-mghNEICAZhgNYrGNfChiUM" />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f5f4f3" />
<link rel="preload" as="font" type="font/woff2" href={url('/fonts/writer-regular.woff2')} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={url('/fonts/plexserif-var.woff2')} crossorigin />

<link rel="canonical" href={canonicalURL} />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Jitendra Verma" />
<meta property="og:locale" content="en_IN" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
