---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import authorsData from '../data/authors.json';

// An avatar given as a bare filename refers to src/assets and gets optimised;
// anything absolute or remote is passed through untouched.
const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,jpeg,png,webp}', { eager: true });

const resolveAvatar = async (avatar?: string) => {
    if (!avatar || avatar.startsWith('/') || avatar.startsWith('http')) return avatar;
    const asset = assets[`../assets/${avatar}`];
    if (!asset) return avatar;
    return (await getImage({ src: asset.default, width: 160, height: 160, format: 'webp' })).src;
};

interface Props {
  nameOrSlug: string;
}

const { nameOrSlug } = Astro.props;

const normalize = (s: string) => {
    if (!s) return "";
    return s.toLowerCase().replace(/[^a-z0-9]/g, '');
};

const target = normalize(nameOrSlug);

let author = authorsData.find(a => a.id === nameOrSlug);

if (!author && target) {
    author = authorsData.find(a => {
        const dbName = normalize(a.name);
        return dbName.includes(target) || target.includes(dbName);
    });
}

const member = author ? { ...author, avatar: await resolveAvatar(author.avatar) } : null;
---

{member ? (
    <span class="author-link author-modal-trigger" data-member={JSON.stringify(member)} style="cursor: pointer;">
        {member.name}
    </span>
) : (
    <span>{nameOrSlug.replace(/[{}]/g, '')}</span>
)}