const glyph = solid[name];
---

{glyph ? (
	<svg class={className} viewBox={glyph[0]} fill="currentColor" aria-hidden="true"><path d={glyph[1]} /></svg>
) : (
	<svg
		class={className}
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.8"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		set:html={line[name] ?? ''}
	/>
)}
