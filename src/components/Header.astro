---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { CV_PDF, CV_URL, GITHUB_PROFILE, SITE_HANDLE } from '../consts';
import { url } from '../utils/paths';
import { profileImg } from '../utils/profileImage';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = Astro.url.pathname.replace(base, '').split('/').filter(Boolean)[0] ?? '';

const links = [
	{ href: url('/projects'), label: 'Projects', section: 'projects' },
	{ href: url('/blog'), label: 'Blog', section: 'blog' },
];
const current = (s: string) => (s === section || (s === 'blog' && (section === 'tags' || section === 'archive')) ? 'page' : undefined);
---

<div class="header-wrap">
	<header class="band site-header">
		<i class="node bl"></i><i class="node br"></i>
		<span class="gutter"></span>
		<span class="rail"></span>
		<div class="hold">
			<i class="node bl"></i><i class="node br"></i>
			<nav class="nav" aria-label="Main">
				<a class="brand" href={url('/')}>
					<Image class="brand-avatar" src={profileImg} alt="" width={48} height={48} loading="eager" />
					<span>{SITE_HANDLE}</span>
				</a>
				<div class="nav-right">
					<div class="nav-links">
						{links.map((l) => <a href={l.href} aria-current={current(l.section)}>{l.label}</a>)}
					</div>
					<button class="icon-btn search-toggle" type="button" aria-label="Search">
						<Icon name="search" />
					</button>
					<a class="icon-btn nav-github" href={GITHUB_PROFILE} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
						<Icon name="github" />
					</a>
					<button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
						<Icon name="sun" class="sun-icon" />
						<Icon name="moon" class="moon-icon" />
					</button>
					<a class="button primary nav-cta" href={url(CV_URL)} data-resume-pdf={url(CV_PDF)}>Resume<kbd aria-hidden="true">R</kbd></a>
					<button class="icon-btn menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
						<Icon name="menu" />
					</button>
				</div>
			</nav>
		</div>
		<span class="rail"></span>
		<span class="gutter right"></span>
	</header>

	<nav class="mobile-nav" id="mobile-nav" aria-label="Menu" hidden>
		{links.map((l) => <a href={l.href} aria-current={current(l.section)}>{l.label}</a>)}
		<a href={url(CV_URL)} data-resume-pdf={url(CV_PDF)}>Resume</a>
		<a href={GITHUB_PROFILE} target="_blank" rel="noopener noreferrer">GitHub</a>
	</nav>
</div>

<script is:inline>
	(() => {
		const root = document.documentElement;
		document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = next;
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#121316' : '#f5f4f3');
			try {
				localStorage.setItem('theme', next);
			} catch {}
		});

		const menu = document.getElementById('mobile-nav');
		const toggle = document.querySelector('.menu-toggle');
		const setMenu = (open) => {
			menu.hidden = !open;
			toggle.setAttribute('aria-expanded', String(open));
		};
		toggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			setMenu(menu.hidden);
		});
		document.addEventListener('click', (e) => {
			if (!menu.hidden && !menu.contains(e.target)) setMenu(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !menu.hidden) setMenu(false);
		});

		for (const btn of document.querySelectorAll('.search-toggle')) {
			btn.addEventListener('click', () => document.dispatchEvent(new CustomEvent('open-search')));
		}

		// the in-page pdf viewer is unreliable on phones and ipads, so resume links go straight to the pdf
		// there. this runs while the header is still parsing, so wait for the rest of the page first.
		const touch = window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 1;
		if (touch) {
			const pointAtPdf = () => {
				for (const link of document.querySelectorAll('a[data-resume-pdf]')) {
					link.setAttribute('href', link.getAttribute('data-resume-pdf'));
				}
			};
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', pointAtPdf);
			} else {
				pointAtPdf();
			}
		}

		document.addEventListener('keydown', (e) => {
			if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || e.repeat) return;
			if (e.target.closest?.('input, textarea, select, [contenteditable], dialog')) return;
			// the search panel is a div, not a dialog, so check it by hand
			if (document.getElementById('search-overlay')?.hidden === false) return;
			const key = e.key.toUpperCase();
			const hit = [...document.querySelectorAll('a kbd')].find((k) => k.textContent.trim() === key);
			if (hit) {
				e.preventDefault();
				hit.closest('a').click();
			}
		});
	})();
</script>
