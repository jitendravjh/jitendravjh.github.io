---
import HeaderLink from './HeaderLink.astro';
import { CV_URL, GITHUB_PROFILE, INTRO, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

const cvHref = CV_URL ? url(CV_URL) : null;
// Touch devices (phones, iPads) get sent straight to the PDF — the in-page
// iframe viewer at /resume is unreliable there. The <script> below swaps the href.
const cvPdfHref = cvHref ? url('/resume/resume.pdf') : null;
---

<div class="nav-aura" aria-hidden="true" style={`background-image: url(${url(INTRO.image)})`}></div>

<header>
	<nav>
		<h2>
			<a href={url('/')}>
				<img class="nav-avatar" src={url(INTRO.image)} alt="" aria-hidden="true" />
				<span>{SITE_TITLE}</span>
			</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href={url('/blog')}>Blog</HeaderLink>
			<HeaderLink href={url('/projects')}>Projects</HeaderLink>
			<HeaderLink href={url('/about')}>About</HeaderLink>
			{cvHref && <HeaderLink href={cvHref} data-resume-pdf={cvPdfHref}>Resume</HeaderLink>}
		</div>

        <div class="header-actions">
            <a href={GITHUB_PROFILE} target="_blank" rel="noopener noreferrer" class="github-link" aria-label="GitHub Profile" title="GitHub Profile">
                <i class="fab fa-github" aria-hidden="true"></i>
            </a>
            <button id="search-toggle-desktop" class="search-toggle" aria-label="Search site">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            </button>
            <button id="theme-toggle" aria-label="Toggle Dark Mode">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>

            <button id="menu-toggle" aria-label="Toggle Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
        </div>
	</nav>

    <div id="mobile-menu" class="mobile-menu hidden">
        <div class="mobile-menu-header">
            <span class="mobile-menu-title">Menu</span>
            <button id="search-toggle-mobile" class="search-toggle" aria-label="Search site">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            </button>
        </div>
        <a href={url('/blog')}>Blog</a>
        <a href={url('/projects')}>Projects</a>
        <a href={url('/about')}>About</a>
        {cvHref && <a href={cvHref} data-resume-pdf={cvPdfHref}>Resume</a>}
    </div>
</header>

<script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const newTheme = isDark ? 'light' : 'dark';
        (window as any).__setPreferredTheme?.(newTheme);
        localStorage.setItem('theme', newTheme);
    });

    document.getElementById('menu-toggle')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });

    document.querySelectorAll('.search-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
            document.dispatchEvent(new CustomEvent('open-search'));
        });
    });

    // On touch devices (phones + iPads) the in-page PDF viewer iframe is unreliable,
    // so point every resume link (nav, footer, home, 404 — any a[data-resume-pdf])
    // straight at the PDF instead of the /resume viewer. This runs on every page.
    // (pointer: coarse) catches phones/tablets; maxTouchPoints covers iPadOS desktop mode.
    const isTouchDevice =
        window.matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 1;
    if (isTouchDevice) {
        document.querySelectorAll('a[data-resume-pdf]').forEach((link) => {
            const pdf = link.getAttribute('data-resume-pdf');
            if (pdf) link.setAttribute('href', pdf);
        });
    }
</script>

<style>
	/* Floating frosted "pill" nav — ente.com-inspired: space above, full side radius, glassy blur */
	header {
		position: sticky;
		top: 0.75rem;
		z-index: 100;
		margin: 0.75rem auto 0;
		width: calc(100% - 2rem);
		max-width: var(--max-width);
		padding: 0 0.6rem 0 1.5rem;
		background-color: var(--color-bg-header);
        backdrop-filter: blur(24px) saturate(180%);
        -webkit-backdrop-filter: blur(24px) saturate(180%);
        border: 1px solid var(--color-header-border);
        border-radius: 999px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.05);
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4rem;
	}
	h2 {
		margin: 0;
		font-size: 1.3em;
		font-family: var(--font-sans);
        font-weight: 800;
        letter-spacing: -0.02em;
        border-bottom: none;
        padding-bottom: 0;
	}
	h2 a {
		text-decoration: none;
		color: var(--color-accent-text);
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
	}
	.nav-avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		border: 1px solid var(--color-header-border);
		box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
	}

	/* The pill is frosted glass, but at the top of the page it has nothing behind it
	   to refract. This lays the profile photo just under the bar — invisible on its own,
	   it only reads as the colour the glass picks up and blurs. */
	.nav-aura {
		position: fixed;
		top: 1.05rem;
		left: 50%;
		transform: translateX(-50%);
		width: min(calc(100% - 3rem), calc(var(--max-width) - 1rem));
		height: 3.4rem;
		border-radius: 999px;
		background-size: cover;
		background-position: center 35%;
		background-repeat: no-repeat;
		filter: blur(6px) saturate(1.5);
		opacity: 0.5;
		z-index: 90;
		pointer-events: none;
		-webkit-mask-image: radial-gradient(120% 100% at 18% 50%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 78%);
		mask-image: radial-gradient(120% 100% at 18% 50%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 78%);
	}
	:global(html[data-theme='dark']) .nav-aura {
		opacity: 0.38;
		filter: blur(6px) saturate(1.3) brightness(0.85);
	}
	@media (max-width: 720px) {
		.nav-aura { height: 3.1rem; }
	}

	.internal-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
	.internal-links :global(a) {
		padding: 0.5em 0.75em;
		color: var(--color-text-main);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
        font-weight: 600;
        border-radius: 999px;
        transition: all 0.2s ease;
	}
	.internal-links :global(a:hover) {
        color: var(--color-accent-text);
        background-color: var(--color-bg-offset);
    }
	.internal-links :global(a.active) {
		text-decoration: none;
		border-bottom-color: var(--color-accent);
		color: var(--color-accent-text);
	}

    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .search-toggle,
    .github-link {
        background: transparent;
        border: none;
        cursor: pointer;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-main);
        font-size: 1.2rem;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }
    .search-toggle:hover,
    .github-link:hover {
        background-color: var(--color-bg-offset);
        color: var(--color-accent-text);
    }

    /* Light/dark toggle styled as ente's solid "black button" pill */
    #theme-toggle {
        margin-left: 0.3rem;
        background-color: var(--color-btn-bg);
        color: var(--color-btn-text);
        border: 1px solid var(--color-header-border);
        cursor: pointer;
        height: 40px;
        min-width: 56px;
        padding: 0 1rem;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, color 0.2s ease, transform 0.1s ease;
    }
    #theme-toggle:hover {
        background-color: var(--color-accent);
        color: #000000;
    }
    #theme-toggle:active {
        transform: scale(0.95);
    }
    #theme-toggle svg {
        width: 18px;
        height: 18px;
    }
    /* Dark mode: invert the toggle — light pill + dark icon (mirrors the black pill in light mode).
       :global() keeps the html[data-theme] selector from being scoped away. */
    :global(html[data-theme="dark"]) #theme-toggle {
        background-color: var(--color-text-main);
        color: var(--color-bg);
        border-color: transparent;
    }
    :global(html[data-theme="dark"]) #theme-toggle:hover {
        background-color: var(--color-accent);
        color: #000000;
    }

    .mobile-menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 0.25rem;
    }
    .mobile-menu-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--color-text-muted);
        padding-left: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    #menu-toggle {
        display: none;
        background: transparent;
        border: none;
        cursor: pointer;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        color: var(--color-text-main);
    }

    .mobile-menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0.5rem;
        width: fit-content;
        min-width: 180px;
        background-color: var(--color-bg-mobile-menu);
        backdrop-filter: blur(40px) saturate(150%);
        -webkit-backdrop-filter: blur(40px) saturate(150%);
        border: 1px solid var(--color-header-border);
        border-radius: 18px;
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
        z-index: 200;
        animation: menuFadeIn 0.2s ease;
    }
    @keyframes menuFadeIn {
        from { opacity: 0; transform: translateY(-8px) scale(0.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .mobile-menu a {
        padding: 0.5rem 0.875rem;
        text-decoration: none;
        color: var(--color-text-main);
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 10px;
        transition: background-color 0.2s, color 0.2s;
    }
    .mobile-menu a:hover {
        background-color: var(--color-bg-offset);
        color: var(--color-accent-text);
    }
    .hidden { display: none; }

    .moon-icon { display: none; }
    .sun-icon { display: block; }
    :global(html[data-theme="dark"]) .moon-icon { display: block; }
    :global(html[data-theme="dark"]) .sun-icon { display: none; }

	@media (min-width: 721px) {
        #menu-toggle { display: none; }
        .mobile-menu { display: none !important; }
	}

	@media (max-width: 720px) {
		.internal-links { display: none; }
        #menu-toggle { display: flex; }
        #search-toggle-desktop { display: none !important; }
        header { padding: 0 0.5rem 0 1.1rem; }
	}
</style>
