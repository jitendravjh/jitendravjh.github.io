---
export interface Props {
	headings: { depth: number; slug: string; text: string }[];
	mobile?: boolean;
}

const { headings, mobile = false } = Astro.props;
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);

const list = toc.map((h) => ({ ...h, nested: h.depth === 3 }));
---

{toc.length > 0 && (mobile ? (
	<details class="toc-panel" data-pagefind-ignore>
		<summary>On this page</summary>
		<nav class="toc" aria-label="On this page" data-pagefind-ignore>
			<ul>
				{list.map((h) => <li class:list={{ nested: h.nested }}><a href={`#${h.slug}`}>{h.text}</a></li>)}
			</ul>
		</nav>
	</details>
) : (
	<nav class="toc" aria-label="On this page" data-pagefind-ignore>
		<h2>On this page</h2>
		<ul>
			{list.map((h) => <li class:list={{ nested: h.nested }}><a href={`#${h.slug}`}>{h.text}</a></li>)}
		</ul>
	</nav>
))}

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')];
	const targets = [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')];

	if (links.length && targets.length) {
		const mark = (id: string) => {
			for (const a of links) {
				a.setAttribute('aria-current', decodeURIComponent(a.hash.slice(1)) === id ? 'true' : 'false');
			}
		};
		const seen = new Map<string, boolean>();
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) seen.set(e.target.id, e.isIntersecting);
				const first = targets.find((t) => seen.get(t.id));
				if (first) mark(first.id);
			},
			{ rootMargin: '-80px 0px -70% 0px', threshold: 0 },
		);
		for (const t of targets) io.observe(t);
		mark(targets[0].id);
	}
</script>
