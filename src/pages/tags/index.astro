---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const tag of posts.flatMap((post) => post.data.tags || [])) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts.keys()].sort();
---

<Base title={`Tags | ${SITE_TITLE}`} description="Browse articles by topic.">
	<Band nodes="b" seed={5}>
		<div class="pat grid"></div>
		<div class="pat glow"></div>
		<header class="page-head">
			<h1 class="h0">Tags</h1>
			<p>Browse articles by topic.</p>
			<div class="head-links" data-pagefind-ignore>
				<a href={url('/blog')}>All posts</a>
				<a href={url('/archive')}>Archive</a>
			</div>
		</header>
	</Band>

	<Band nodes="b" seed={23}>
		<div class="tag-cloud">
			{tags.map((tag) => (
				<a class="chip tag" href={url(`/tags/${tag}`)}>#{tag}<span class="count">{counts.get(tag)}</span></a>
			))}
			{tags.length === 0 && <p>No tags yet.</p>}
		</div>
	</Band>
</Base>
