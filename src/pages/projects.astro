---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
import { url } from '../utils/paths';

// ordered by impact rather than by date, the data file is curated most significant first
const projects = projectsData;
---

<Base title={`Projects | ${SITE_TITLE}`} description="Apps, games, and open-source work by Jitendra Verma.">
	<Band nodes="b" seed={5}>
		<div class="pat grid"></div>
		<div class="pat glow"></div>
		<header class="page-head">
			<h1 class="h0">Projects</h1>
			<p>Apps, games, and open-source work I've built - across Flutter, Swift, and the web.</p>
		</header>
	</Band>

	<Band nodes="b" seed={23}>
		<div class="cards two">
			{projects.map((project) => {
				const main = project.links[0];
				return (
					<article class="cell" id={project.id}>
						<a href={main?.href ?? `#${project.id}`} target={main ? '_blank' : undefined} rel={main ? 'noopener noreferrer' : undefined} tabindex="-1" aria-label={project.title}>
							<div class="frame poster-frame">
								<div class="framed">
									<img class="poster-light" src={url(`/projects/${project.id}-light.png`)} alt="" loading="lazy" width="1200" height="630" />
									<img class="poster-dark" src={url(`/projects/${project.id}.png`)} alt="" loading="lazy" width="1200" height="630" />
								</div>
							</div>
						</a>
						<span class="meta">{project.status} · {project.year}</span>
						<h3>
							{main ? <a href={main.href} target="_blank" rel="noopener noreferrer">{project.title}</a> : project.title}
						</h3>
						<p>{project.description}</p>
						{project.tech && <p class="tech">{project.tech}</p>}
						{project.links.length > 0 && (
							<div class="links">
								{project.links.map((link, i) => (
									<a class:list={['button small', i === 0 ? 'primary' : 'secondary']} href={link.href} target="_blank" rel="noopener noreferrer">
										{link.label} &#8599;
									</a>
								))}
							</div>
						)}
					</article>
				);
			})}
		</div>
	</Band>
</Base>
