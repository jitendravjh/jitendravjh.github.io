---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import Icon from '../../components/Icon.astro';
import { CV_PDF, SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';

const pdf = url(CV_PDF);
---

<Base title={`Resume - ${SITE_TITLE}`} description="Resume of Jitendra Verma.">
	<Band nodes="b" seed={5}>
		<div class="pat grid"></div>
		<div class="pat glow"></div>
		<header class="resume-head">
			<div>
				<h1 class="h0">Resume</h1>
				<p>Computer Science &amp; Engineering, Uka Tarsadia University, 2022 to 2026.</p>
			</div>
			<div class="resume-actions">
				<a class="button primary" href={pdf} target="_blank" rel="noopener noreferrer"><Icon name="download" />Download PDF</a>
				<a class="button secondary" href={url('/')}>Home</a>
			</div>
		</header>
	</Band>

	<Band nodes="b" seed={23}>
		<div class="resume-view">
			<div class="frame">
				<div class="framed">
					<iframe src={pdf} title="Resume PDF"></iframe>
				</div>
			</div>
		</div>
	</Band>
</Base>
